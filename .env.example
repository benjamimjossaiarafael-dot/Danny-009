# Free Fire Africa API - .env example

# Server
PORT=3000

# JWT
JWT_SECRET=replace_this_with_strong_secret
JWT_REFRESH_SECRET=replace_refresh_secret

# Database
DATABASE_FILE=./data/database.sqlite

# Free Fire API (if you have credentials; otherwise simulated)
FREEFIRE_API_KEY=
FREEFIRE_API_URL=https://api.freefire.example

# Email (for 2FA/email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=supersecret

# Node environment
NODE_ENV=development
